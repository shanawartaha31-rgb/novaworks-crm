# PostgreSQL connection string (local or Aiven/Neon). Aiven needs ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novaworks"

# Secret used to sign the login session cookie (any long random string)
SESSION_SECRET="replace-with-a-long-random-string"

# AI provider — set ONE of these.
# Option A: Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Option B: any OpenAI-compatible API (OpenAI, Groq, OpenRouter...)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
